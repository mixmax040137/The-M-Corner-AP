    "deploy": "node scripts/vendor.mjs && node scripts/embed.mjs && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource/charm": "5.3.0",
    "@fontsource/kanit": "5.3.0",
    "@fontsource/mitr": "5.3.0",
    "@fontsource/prompt": "5.3.0",
    "@fontsource/sarabun": "5.3.0",
    "@jsquash/avif": "2.1.1",
    "docxtemplater": "3.71.1",
    "esbuild": "0.28.2",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "heic2any": "0.0.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pizzip": "3.3.0",
    "wrangler": "4.158.0",
    "xlsx": "0.18.5"
  },
  "private": true,
  "type": "module"
}